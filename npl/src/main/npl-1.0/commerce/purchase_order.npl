package commerce

use schemaorg.v1.MonetaryAmount;
use schemaorg.v1.QuantitativeValue;
use commerce.Offer;

/**
 * Notification sent when a purchase order requires human approval.
 * Orders >= $5000 require approval. The protocolId is the PurchaseOrder ID.
 * This is sent automatically in the init block based on order total.
 * @param orderNumber Human-readable order number
 * @param total Order total in dollars (approval threshold is $5000)
 * @param quantity Number of items ordered
 */
notification ApprovalRequiredNotification(orderNumber: Text, total: Number, quantity: Number) returns Unit;

/**
 * Notification sent to buyer when their order is approved.
 * Buyer can now call placeOrder() to finalize.
 * @param orderNumber Human-readable order number
 * @param total Order total
 */
notification OrderApprovedNotification(orderNumber: Text, total: Number) returns Unit;

/**
 * Notification sent to buyer when their order ships.
 * Buyer can track delivery and call closeOrder() when received.
 * @param orderNumber Human-readable order number
 * @param tracking Shipping tracking number
 */
notification OrderShippedNotification(orderNumber: Text, tracking: Text) returns Unit;

/**
 * Notification sent to seller when buyer places order (after quote/approval).
 * Seller should prepare to ship.
 * @param orderNumber Human-readable order number
 * @param quantity Number of items to ship
 */
notification OrderPlacedNotification(orderNumber: Text, quantity: Number) returns Unit;

/**
 * PurchaseOrder - Governed purchase order with approval workflow
 * 
 * Demonstrates how AI agents can participate in business workflows
 * while being safely governed by NPL protocol rules.
 * 
 * Key features:
 * - Price and quantity automatically computed from accepted Offer (single source of truth)
 * - Orders above $5,000 require human approval (auto-routed in submit)
 * - Only users with 'approver' role can approve
 * - Agents cannot bypass approval requirements
 * - All actions are auditable
 * 
 * Workflow:
 * 1. Agent accepts an Offer (price + quantity locked in Offer protocol)
 * 2. Agent creates PurchaseOrder with only orderNumber + acceptedOffer
 * 3. Buyer calls submit() → auto-routes to ApprovalRequired or Quoted
 * 4. [If needed] Human approves → Approved
 * 5. Buyer places order → Ordered
 * 6. Supplier ships → Shipped
 * 7. Buyer closes → Closed
 * 
 * Note: quantity, unitPrice, and total are computed functions (not constructor params).
 * They're derived from the acceptedOffer and exposed via @api permissions.
 * This ensures the Offer is the single source of truth for pricing.
 * 
 * Example Usage:
 *   PurchaseOrder(
 *       orderNumber = "PO-2024-001",
 *       acceptedOffer = offerProtocol
 *   )
 */
@api
protocol[buyer, seller, approver] PurchaseOrder(
    var orderNumber: Text,
    var acceptedOffer: Offer
) {
    require(orderNumber.length() > 0, "Order number is required");
    
    // Computed values derived from accepted offer (single source of truth)
    function quantity() returns Number -> acceptedOffer.availableQuantity.value;
    function unitPrice() returns Number -> acceptedOffer.priceSpecification.price;
    function total() returns Number -> quantity() * unitPrice();
    
    // Approval threshold constant - orders >= $5,000 require approval
    var APPROVAL_THRESHOLD: Number = 5000.0;
    
    // States matching the PoC specification
    initial state Requested;
    state Quoted;
    state ApprovalRequired;
    state Approved;
    state Ordered;
    state Shipped;
    final state Closed;
    final state Cancelled;
    
    // Internal state tracking
    var approvedAt: Optional<DateTime> = optionalOf<DateTime>();
    var orderedAt: Optional<DateTime> = optionalOf<DateTime>();
    var shippedAt: Optional<DateTime> = optionalOf<DateTime>();
    var trackingNumber: Optional<Text> = optionalOf<Text>();
    
    /**
     * Buyer submits the purchase order for processing
     * 
     * This auto-routes based on total amount:
     * - If total >= $5,000 → ApprovalRequired state (notifies approver)
     * - If total < $5,000 → Quoted state (can proceed directly)
     * 
     * The price comes from the accepted Offer, so no re-negotiation needed.
     */
    @api
    permission[buyer] submit() | Requested {
        if (total() >= APPROVAL_THRESHOLD) {
            notify ApprovalRequiredNotification(orderNumber, total(), quantity());
            become ApprovalRequired;
        } else {
            become Quoted;
        };
    };
    
    /**
     * Human approver approves high-value order
     * 
     * CRITICAL: Only users with 'approver' role can execute this.
     * NPL enforces this at the protocol level - no agent can bypass.
     */
    @api
    permission[approver] approve() | ApprovalRequired {
        approvedAt = optionalOf(now());
        notify OrderApprovedNotification(orderNumber, total());
        become Approved;
    };
    
    /**
     * Buyer agent attempts to place order
     * 
     * BLOCKED unless:
     * - Quote has been submitted (Quoted or Approved state)
     * - If approval was required, it must be granted (Approved state)
     * 
     * This demonstrates "LLMs suggest, NPL decides" principle.
     */
    @api
    permission[buyer] placeOrder() | Quoted, Approved {
        orderedAt = optionalOf(now());
        notify OrderPlacedNotification(orderNumber, quantity());
        become Ordered;
    };
    
    /**
     * Seller ships the order
     */
    @api
    permission[seller] shipOrder(tracking: Text) | Ordered {
        require(tracking.length() > 0, "Tracking number is required");
        trackingNumber = optionalOf(tracking);
        shippedAt = optionalOf(now());
        notify OrderShippedNotification(orderNumber, tracking);
        become Shipped;
    };
    
    /**
     * Close the order (buyer confirms receipt)
     */
    @api
    permission[buyer] closeOrder() | Shipped {
        become Closed;
    };
    
    /**
     * Cancel the order (both parties can cancel before shipping)
     */
    @api
    permission[buyer | seller] cancelOrder(reason: Text) | Requested, Quoted, ApprovalRequired, Approved, Ordered {
        require(reason.length() > 0, "Cancellation reason is required");
        become Cancelled;
    };
    
    /**
     * Get order summary with approval status
     */
    @api
    permission[buyer | seller | approver] getOrderSummary() returns Text {
        var approvalStatus = if (total() >= APPROVAL_THRESHOLD) {
            if (approvedAt.isPresent()) {
                "Approved"
            } else {
                "Approval Required"
            };
        } else {
            "No Approval Needed"
        };
        
        return "PO " + orderNumber + 
               " | Qty: " + quantity().toText() + 
               " @ $" + unitPrice().toText() + 
               " | Total: $" + total().toText() + 
               " | " + approvalStatus;
    };
    
    /**
     * Check if approval is required for this order
     */
    @api
    permission[buyer | seller | approver] requiresApproval() returns Boolean {
        return total() >= APPROVAL_THRESHOLD;
    };
    
    /**
     * Get the accepted offer details
     */
    @api
    permission[buyer | seller | approver] getAcceptedOffer() returns Offer {
        return acceptedOffer;
    };
    
    /**
     * Get the order quantity (computed from accepted offer)
     */
    @api
    permission[buyer | seller | approver] getQuantity() returns Number {
        return quantity();
    };
    
    /**
     * Get the unit price (computed from accepted offer)
     */
    @api
    permission[buyer | seller | approver] getUnitPrice() returns Number {
        return unitPrice();
    };
    
    /**
     * Get the total amount (computed from quantity × unit price)
     */
    @api
    permission[buyer | seller | approver] getTotal() returns Number {
        return total();
    };
};
